# Optional Cloudflare WARP over Xray MASQUE.
# Copy to config/warp-masque.env; no private keys or API tokens belong here.
WARP_MASQUE_TRANSPORT="h2"
WARP_MASQUE_TAG="warp-masque"
WARP_MASQUE_ENDPOINT_PORT="443"
WARP_MASQUE_SERVER_NAME="consumer-masque.cloudflareclient.com"
# Consumer registration API is undocumented and may change.
WARP_MASQUE_API_URL="https://api.cloudflareclient.com/v0a4471/reg"
WARP_MASQUE_CLIENT_VERSION="a-6.35-4471"
WARP_MASQUE_MIN_XRAY_VERSION="26.10.31"
WARP_MASQUE_STATE_DIR="/var/lib/server-deployment/warp-masque"
WARP_MASQUE_BACKUP_DIR="/var/backups/server-deployment/warp-masque"
