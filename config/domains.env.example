# Copy to domains.env; use only domains you control.
# Space-separated SNI names routed to the Remnawave/Xray backend.
REMNAWAVE_SNI_DOMAINS="gateway.example.com sync.example.com storage.example.com"
WEB_DOMAIN="cdn.example.com"

# Optional HTTP -> HTTPS redirects:
# - Leave empty to keep strict behavior (unknown Host values receive 404).
# - List hostnames to redirect only those hosts.
# - Set exactly "all" to redirect every HTTP request handled by HAProxy.
# ACME HTTP-01 requests under /.well-known/acme-challenge/ remain reachable.
HTTP_REDIRECT_DOMAINS=""
