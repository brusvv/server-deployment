# Copy to domains.env; use only domains you control.
# Space-separated SNI names routed to the Remnawave/Xray backend.
REMNAWAVE_SNI_DOMAINS="gateway.example.com sync.example.com storage.example.com"
WEB_DOMAIN="cdn.example.com"

# Optional, space-separated hosts that should receive HTTP -> HTTPS redirects.
# Leave empty to preserve the strict/default HTTP frontend behavior.
# Include WEB_DOMAIN, Remnawave SNI names and a Selfmask/API hostname as needed.
HTTP_REDIRECT_DOMAINS=""
