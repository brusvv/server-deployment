REMNAWAVE_DIR="/opt/remnawave"
MTProxyL_DIR="/opt/mtproxyl"
MTPROXYL_SETTINGS="/opt/mtproxyl/settings.conf"
HAPROXY_CONFIG="/opt/mtproxyl/haproxy-custom.cfg"
HAPROXY_BIN="/opt/mtproxyl-haproxy/sbin/haproxy"
HAPROXY_SERVICE="mtproxyl-haproxy.service"
XRAY_SERVICE_HINT="remnanode"
NGINX_SOCKET="/dev/shm/nginx.sock"
STATE_DIR="/var/lib/server-deployment"
BACKUP_DIR="/var/backups/server-deployment"
XRAY_LISTENER_PROCESS_HINT="rw-core"
MTPROTO_LISTENER_PROCESS_HINT="mtproxyl-telemt"
WEB_HTTP_LISTENER_PROCESS_HINT="mtproxyl-telemt"
# Optional: set this to the actual process name shown by ss -lntp for port 15481.
STATIC_LISTENER_PROCESS_HINT=""
# Optional: set process-name hints if the static and Selfmask backends use different daemons.
SELFSTEAL_BACKEND_PROCESS_HINT=""
